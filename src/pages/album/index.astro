---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../../consts';

const albums = (await getCollection('album')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
---

<!doctype html>
<html lang="ja">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main class="max-w-6xl mx-auto px-4 py-8">
			<h1 class="text-3xl font-bold mb-8">Album</h1>
			<ul class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-6 list-none p-0 m-0">
				{
					albums.map((album) => (
						<li class="bg-white rounded-lg overflow-hidden shadow border border-gray-100 flex flex-col">
							<a href={`${import.meta.env.BASE_URL}album/${album.id}/`} class="group block">
								{album.data.heroImage && (
									<div class="aspect-video overflow-hidden bg-gray-100">
										<img 
											src={album.data.heroImage} 
											alt=""
											class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
										/>
									</div>
								)}
								<div class="p-4">
									<p class="text-xs text-gray-500 mb-1">
										<time datetime={album.data.pubDate.toISOString()}>
											{album.data.pubDate.toLocaleDateString('ja-JP')}
										</time>
										{album.data.location && ` / ${album.data.location}`}
									</p>
									<h2 class="font-bold text-lg text-gray-900 group-hover:text-blue-600 transition-colors m-0">
										{album.data.title}
									</h2>
								</div>
							</a>
						</li>
					))
				}
			</ul>
		</main>
		<Footer />
	</body>
</html>
