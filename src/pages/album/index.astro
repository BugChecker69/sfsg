---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../../consts';

const albums = (await getCollection('album')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
---

<!doctype html>
<html lang="ja">
	<head>
		<BaseHead title={`Album - ${SITE_TITLE}`} description={SITE_DESCRIPTION} />
		<style>
			main {
				width: 960px;
				max-width: calc(100% - 2rem);
				margin: 0 auto;
				padding: 3rem 1rem;
				box-sizing: border-box;
			}
			.album-grid {
				display: grid;
				grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
				gap: 1.5rem;
				list-style-type: none;
				margin: 0;
				padding: 0;
			}
			.album-item {
				background: #fff;
				border-radius: 12px;
				overflow: hidden;
				box-shadow: 0 4px 6px rgba(0,0,0,0.05);
				transition: transform 0.2s ease, box-shadow 0.2s ease;
				cursor: pointer;
			}
			.album-item:hover {
				transform: translateY(-4px);
				box-shadow: 0 10px 15px rgba(0,0,0,0.1);
			}
			.album-thumb {
				width: 100%;
				height: 160px;
				object-fit: cover;
				display: block;
			}
			.album-info {
				padding: 1rem;
			}
			.album-title {
				font-size: 1rem;
				margin: 0 0 0.5rem 0;
				color: rgb(var(--black));
			}
			.album-date {
				font-size: 0.85rem;
				color: rgb(var(--gray));
				margin: 0;
			}

			/* モーダル（拡大表示）のスタイル */
			dialog {
				border: none;
				border-radius: 16px;
				padding: 1.5rem;
				max-width: 90vw;
				max-height: 90vh;
				background: #fff;
				box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.25);
			}
			dialog::backdrop {
				background: rgba(0, 0, 0, 0.6);
			}
			.modal-content {
				display: flex;
				flex-direction: column;
				align-items: center;
				gap: 0.75rem;
				text-align: center;
			}
			.modal-image {
				max-width: 100%;
				max-height: 60vh;
				object-fit: contain;
				border-radius: 8px;
			}
			.close-btn {
				background: #333;
				color: #fff;
				border: none;
				padding: 0.5rem 1.5rem;
				border-radius: 8px;
				cursor: pointer;
				font-size: 0.9rem;
				margin-top: 0.5rem;
			}
			.close-btn:hover {
				background: #555;
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<ul class="album-grid">
				{
					albums.map((album) => {
						let heroImg = album.data.heroImage;
						if (typeof heroImg === 'string') {
							if (heroImg.startsWith('./')) {
								heroImg = `${import.meta.env.BASE_URL}album/${heroImg.replace('./', '')}`;
							} else if (!heroImg.startsWith('http') && !heroImg.startsWith('/sfsg/')) {
								heroImg = `${import.meta.env.BASE_URL}${heroImg.replace(/^\//, '')}`;
							}
						}
						const safeTitle = (album.data.title || '').replace(/'/g, "\\'");
						const safeDesc = (album.data.description || '').replace(/'/g, "\\'");
						return (
							<li class="album-item" id={album.id} onclick={`openModal('${heroImg}', '${safeTitle}', '${safeDesc}')`}>
								{heroImg && (
									typeof heroImg === 'string' ? (
										<img class="album-thumb" width={400} height={300} src={heroImg} alt={album.data.title} />
									) : (
										<Image class="album-thumb" width={400} height={300} src={heroImg} alt={album.data.title} />
									)
								)}
								<div class="album-info">
									<h3 class="album-title">{album.data.title}</h3>
									<p class="album-date">{album.data.pubDate.toLocaleDateString()}</p>
								</div>
							</li>
						);
					})
				}
			</ul>

			<!-- 拡大表示用モーダル -->
			<dialog id="imageModal">
				<div class="modal-content">
					<img id="modalImg" class="modal-image" src="" alt="" />
					<h3 id="modalTitle" style="margin: 0; font-size: 1.1rem; font-weight: bold;"></h3>
					<p id="modalDesc" style="margin: 0; font-size: 0.95rem; color: rgb(var(--gray-dark));"></p>
					<button class="close-btn" onclick="closeModal()">閉じる</button>
				</div>
			</dialog>

			<script is:inline>
				function openModal(imgSrc, title, description) {
					const modal = document.getElementById('imageModal');
					const modalImg = document.getElementById('modalImg');
					const modalTitle = document.getElementById('modalTitle');
					const modalDesc = document.getElementById('modalDesc');
					
					modalImg.src = imgSrc;
					modalTitle.textContent = title;
					modalDesc.textContent = description || '';
					modal.showModal();
				}

				function closeModal() {
					const modal = document.getElementById('imageModal');
					modal.close();
				}

				const modal = document.getElementById('imageModal');
				modal?.addEventListener('click', (event) => {
					const rect = modal.getBoundingClientRect();
					if (
						event.clientX < rect.left ||
						event.clientX > rect.right ||
						event.clientY < rect.top ||
						event.clientY > rect.bottom
					) {
						modal.close();
					}
				});

				window.addEventListener('DOMContentLoaded', () => {
					const hash = window.location.hash;
					if (hash) {
						const targetId = hash.replace('#', '');
						const targetItem = document.getElementById(targetId);
						if (targetItem) {
							targetItem.click();
						}
					}
				});
			</script>
		</main>
		<Footer />
	</body>
</html>
