---
import BaseHead import '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../../consts';

export async function getStaticPaths({ paginate }) {
  // すべての写真・アルバムデータを取得（例としてダミーの配列やコンテンツ取得を使用）
  const allPhotos = [...]; // 写真データの配列
  allPhotos.sort((a, b) => new Date(b.date).valueOf() - new Date(a.date).valueOf());

  return paginate(allPhotos, { pageSize: 15 });
}

const { page } = Astro.props;
---

<!doctype html>
<html lang="ja">
	<head>
		<BaseHead title={`Album (ページ ${page.currentPage}) - ${SITE_TITLE}`} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>
			<h1>Album</h1>
			<div class="album-grid">
				{page.data.map((photo) => (
					<div class="album-item">
						<!-- 写真の表示要素 -->
					</div>
				))}
			</div>

			<!-- ページネーションUI -->
			<nav class="pagination">
				{page.url.prev ? <a href={page.url.prev}>← 前のページ</a> : <span class="disabled">← 前のページ</span>}
				<span>{page.currentPage} / {page.lastPage}</span>
				{page.url.next ? <a href={page.url.next}>次のページ →</a> : <span class="disabled">次のページ →</span>}
			</nav>
		</main>
		<Footer />
	</body>
</html>