const canvas = document.getElementById('gameCanvas');
const ctx = canvas.getContext('2d');
const stageNameEl = document.getElementById('stage-name');
const timerEl = document.getElementById('timer-display');
const clearedCountEl = document.getElementById('cleared-count');
const prefGridEl = document.getElementById('pref-grid');
const soundBtn = document.getElementById('sound-btn');

const STORAGE_KEY = '47touring_cleared_route';

// -------------------------------------------------------------
// Web Audio API：BGM & ゴールファンファーレ
// -------------------------------------------------------------
let audioCtx = null;
let bgmTimer = null;
let isAudioEnabled = true;

const BGM_NOTES = [
  587.33, 739.99, 880.00, 739.99,  554.37, 739.99, 880.00, 739.99,
  493.88, 739.99, 880.00, 739.99,  392.00, 587.33, 783.99, 587.33,
  329.63, 493.88, 659.25, 493.88,  369.99, 554.37, 739.99, 554.37,
  392.00, 587.33, 783.99, 587.33,  440.00, 659.25, 880.00, 659.25
];
const BASS_NOTES = [
  146.83, 146.83, 138.59, 138.59,  123.47, 123.47,  98.00,  98.00,
   82.41,  82.41,  92.50,  92.50,   98.00,  98.00, 110.00, 110.00
];
let bgmStep = 0;

function initAudio() {
  if (!audioCtx) {
    const AudioContext = window.AudioContext || window.webkitAudioContext;
    audioCtx = new AudioContext();
  }
  if (audioCtx.state === 'suspended') {
    audioCtx.resume();
  }
}

function playSynthTone(freq, type, duration, vol, startTime) {
  if (!audioCtx || !isAudioEnabled) return;
  const osc = audioCtx.createOscillator();
  const gain = audioCtx.createGain();
  osc.type = type;
  osc.frequency.setValueAtTime(freq, startTime);
  gain.gain.setValueAtTime(vol, startTime);
  gain.gain.exponentialRampToValueAtTime(0.0001, startTime + duration);
  osc.connect(gain);
  gain.connect(audioCtx.destination);
  osc.start(startTime);
  osc.stop(startTime + duration);
}

function scheduleBGM() {
  if (!isAudioEnabled || !audioCtx) return;
  const now = audioCtx.currentTime;
  const stepTime = 0.125;
  const leadFreq = BGM_NOTES[bgmStep % BGM_NOTES.length];
  playSynthTone(leadFreq, "sawtooth", 0.11, 0.045, now);

  if (bgmStep % 2 === 0) {
    const bassIdx = Math.floor((bgmStep % BGM_NOTES.length) / 2);
    const bassFreq = BASS_NOTES[bassIdx % BASS_NOTES.length];
    playSynthTone(bassFreq, "square", 0.22, 0.055, now);
  }
  bgmStep++;
  bgmTimer = setTimeout(scheduleBGM, stepTime * 1000);
}

function startBGM() {
  initAudio();
  if (bgmTimer) clearTimeout(bgmTimer);
  if (isAudioEnabled) scheduleBGM();
}

function stopBGM() {
  if (bgmTimer) clearTimeout(bgmTimer);
  bgmTimer = null;
}

// 47都道府県制覇時のブラス風ファンファーレ
function playGoalFanfare() {
  if (!audioCtx || !isAudioEnabled) return;
  const now = audioCtx.currentTime;

  // ファンファーレ和音パターン (Bb -> F -> Bb -> D -> F -> High Bb)
  const fanfareEvents = [
    { time: 0.00, freq: 466.16, dur: 0.20, vol: 0.12 },
    { time: 0.22, freq: 466.16, dur: 0.20, vol: 0.12 },
    { time: 0.44, freq: 466.16, dur: 0.20, vol: 0.12 },
    { time: 0.66, freq: 587.33, dur: 0.40, vol: 0.15 },
    { time: 1.10, freq: 698.46, dur: 0.35, vol: 0.15 },
    { time: 1.50, freq: 932.33, dur: 1.80, vol: 0.22 },
    // ハーモニー（和音の厚み）
    { time: 0.66, freq: 349.23, dur: 0.40, vol: 0.09 },
    { time: 1.10, freq: 466.16, dur: 0.35, vol: 0.11 },
    { time: 1.50, freq: 698.46, dur: 1.80, vol: 0.14 },
    { time: 1.50, freq: 466.16, dur: 1.80, vol: 0.12 }
  ];

  fanfareEvents.forEach(ev => {
    playSynthTone(ev.freq, "sawtooth", ev.dur, ev.vol, now + ev.time);
  });
}

soundBtn.addEventListener('click', (e) => {
  e.preventDefault();
  isAudioEnabled = !isAudioEnabled;
  if (isAudioEnabled) {
    soundBtn.textContent = "🔊 BGM: ON";
    soundBtn.style.color = "#fff";
    if (!isClear && !isFerryScene && !isGameOver && !isGrandGoal) {
      startBGM();
    }
  } else {
    soundBtn.textContent = "🔇 BGM: OFF";
    soundBtn.style.color = "#888";
    stopBGM();
  }
});

// -------------------------------------------------------------
// 画像キャッシュ機構
// -------------------------------------------------------------
const imageCache = {};
function getImage(src, fallbackSrc = null) {
  if (!src) return null;
  if (!imageCache[src]) {
    const img = new Image();
    img.src = src;
    if (fallbackSrc) {
      img.onerror = () => {
        img.src = fallbackSrc;
      };
    }
    imageCache[src] = img;
  }
  return imageCache[src];
}

const bikeImg = getImage(ASSET_PATHS.bike);

// 各種アイキャッチ画像のプリロード
const eyecatchImages = ASSET_PATHS.eyecatches.map(url => getImage(url));
const eyecatchFerryImg = getImage(ASSET_PATHS.eyecatchFerry);
const eyecatchGoalImg = getImage(ASSET_PATHS.eyecatchGoal);

let currentStageIndex = 0;
let stageTime = 30.0;
let lastTime = 0;
let isGameOver = false;
let isClear = false;
let isFerryScene = false;
let isGrandGoal = false;
let transitionLockTimer = 0;
let currentEyecatchImg = null;

const player = {
  x: canvas.width / 2 - 18,
  y: canvas.height - 105,
  width: 36,
  height: 72,
  speed: 260,
  moveLeft: false,
  moveRight: false
};

let obstacles = [];
let roadSigns = [];
let spawnTimer = 0;
let roadMarkY = 0;

let photoOverlay = {
  active: false,
  title: "",
  landmarkName: "",
  imgSrc: "",
  timer: 0,
  alpha: 0,
  angle: -0.06
};

let landmarkTriggered1 = false;
let landmarkTriggered2 = false;

function getClearedStages() {
  const data = localStorage.getItem(STORAGE_KEY);
  return data ? JSON.parse(data) : [];
}

function saveStageClear(stageId) {
  const cleared = getClearedStages();
  if (!cleared.includes(stageId)) {
    cleared.push(stageId);
    localStorage.setItem(STORAGE_KEY, JSON.stringify(cleared));
  }
}

function updateAchievementUI() {
  const cleared = getClearedStages();
  clearedCountEl.textContent = cleared.length;
  prefGridEl.innerHTML = '';

  stages.forEach((st, idx) => {
    const badge = document.createElement('div');
    const isCleared = cleared.includes(st.id);
    badge.className = `pref-badge ${isCleared ? 'cleared' : ''} ${idx === currentStageIndex ? 'current' : ''}`;
    badge.textContent = st.name.replace(/[都|府|県]/g, '');
    badge.title = `${st.id}. ${st.name}`;
    badge.addEventListener('click', (e) => {
      e.stopPropagation();
      resetStage(idx);
    });
    prefGridEl.appendChild(badge);
  });
}

function triggerSnapShot(landmarkObj) {
  photoOverlay.active = true;
  photoOverlay.title = stages[currentStageIndex].name;
  photoOverlay.landmarkName = landmarkObj.name;
  photoOverlay.imgSrc = ASSET_PATHS.landmarks + landmarkObj.file;
  photoOverlay.timer = 2.4;
  photoOverlay.alpha = 0;
  photoOverlay.angle = (Math.random() - 0.5) * 0.16;
}

function resetStage(stageIndex) {
  currentStageIndex = stageIndex;
  stageTime = 30.0;
  isGameOver = false;
  isClear = false;
  isFerryScene = false;
  isGrandGoal = false;
  currentEyecatchImg = null;
  transitionLockTimer = 0.5;
  obstacles = [];
  roadSigns = [];
  spawnTimer = 0;
  landmarkTriggered1 = false;
  landmarkTriggered2 = false;
  photoOverlay.active = false;
  player.x = canvas.width / 2 - player.width / 2;
  player.moveLeft = false;
  player.moveRight = false;

  stageNameEl.textContent = `STAGE ${stages[stageIndex].id}: ${stages[stageIndex].name}`;
  timerEl.textContent = `残り: 30.0s`;

  roadSigns.push({
    text: stages[stageIndex].capital,
    y: -40,
    side: "left"
  });

  const cur = stages[stageIndex];
  cur.items.forEach(it => {
    const fallback = it.fallback ? ASSET_PATHS.items + it.fallback : null;
    getImage(ASSET_PATHS.items + it.file, fallback);
  });
  cur.landmarks.forEach(lm => getImage(ASSET_PATHS.landmarks + lm.file));

  if (isAudioEnabled) {
    startBGM();
  }

  updateAchievementUI();
}

window.addEventListener('keydown', (e) => {
  if (isAudioEnabled && !bgmTimer && !isClear && !isFerryScene && !isGameOver && !isGrandGoal) {
    startBGM();
  }
  if (e.key === 'ArrowLeft' || e.key === 'a' || e.key === 'A') player.moveLeft = true;
  if (e.key === 'ArrowRight' || e.key === 'd' || e.key === 'D') player.moveRight = true;
});
window.addEventListener('keyup', (e) => {
  if (e.key === 'ArrowLeft' || e.key === 'a' || e.key === 'A') player.moveLeft = false;
  if (e.key === 'ArrowRight' || e.key === 'd' || e.key === 'D') player.moveRight = false;
});

const btnLeft = document.getElementById('btn-left');
const btnRight = document.getElementById('btn-right');
btnLeft.addEventListener('pointerdown', (e) => {
  e.preventDefault();
  if (isAudioEnabled && !bgmTimer && !isClear && !isFerryScene && !isGameOver && !isGrandGoal) startBGM();
  player.moveLeft = true;
});
btnLeft.addEventListener('pointerup', (e) => { e.preventDefault(); player.moveLeft = false; });
btnLeft.addEventListener('pointerleave', () => player.moveLeft = false);

btnRight.addEventListener('pointerdown', (e) => {
  e.preventDefault();
  if (isAudioEnabled && !bgmTimer && !isClear && !isFerryScene && !isGameOver && !isGrandGoal) startBGM();
  player.moveRight = true;
});
btnRight.addEventListener('pointerup', (e) => { e.preventDefault(); player.moveRight = false; });
btnRight.addEventListener('pointerleave', () => player.moveRight = false);

// 画面タッチ・タップ処理
canvas.addEventListener('pointerdown', (e) => {
  e.preventDefault();

  if (isGameOver || isClear || isFerryScene || isGrandGoal) {
    if (transitionLockTimer > 0) return;

    if (isGameOver) {
      resetStage(currentStageIndex);
    } else if (isFerryScene) {
      isFerryScene = false;
      resetStage(currentStageIndex + 1);
    } else if (isClear) {
      resetStage(currentStageIndex + 1);
    } else if (isGrandGoal) {
      resetStage(0);
    }
    return;
  }

  if (isAudioEnabled && !bgmTimer) startBGM();

  const rect = canvas.getBoundingClientRect();
  const touchX = e.clientX - rect.left;
  if (touchX < rect.width / 2) {
    player.moveLeft = true;
    player.moveRight = false;
  } else {
    player.moveRight = true;
    player.moveLeft = false;
  }
});

window.addEventListener('pointerup', () => {
  if (!isGameOver && !isClear && !isFerryScene && !isGrandGoal) {
    player.moveLeft = false;
    player.moveRight = false;
  }
});

function gameLoop(timestamp) {
  if (!lastTime) lastTime = timestamp;
  const dt = Math.min((timestamp - lastTime) / 1000, 0.1);
  lastTime = timestamp;

  update(dt);
  render();

  requestAnimationFrame(gameLoop);
}

function update(dt) {
  if (transitionLockTimer > 0) {
    transitionLockTimer -= dt;
  }

  if (isGameOver || isClear || isFerryScene || isGrandGoal) return;

  stageTime -= dt;
  if (stageTime <= 0) {
    stageTime = 0;
    saveStageClear(stages[currentStageIndex].id);
    updateAchievementUI();
    transitionLockTimer = 0.5;

    // 通常BGM停止
    stopBGM();

    // 最終ステージ（沖縄県）クリア時はグランドゴール
    if (currentStageIndex === stages.length - 1) {
      isGrandGoal = true;
      timerEl.textContent = "CONGRATULATIONS!";
      playGoalFanfare();
      return;
    }

    // フェリー航行判定
    if (stages[currentStageIndex].ferryNext) {
      isFerryScene = true;
    } else {
      isClear = true;
      const randIdx = Math.floor(Math.random() * eyecatchImages.length);
      currentEyecatchImg = eyecatchImages[randIdx];
    }
    return;
  }
  timerEl.textContent = `残り: ${stageTime.toFixed(1)}s`;

  roadMarkY = (roadMarkY + 360 * dt) % 40;

  const roadLeft = 45;
  const roadRight = canvas.width - 45;
  if (player.moveLeft) player.x -= player.speed * dt;
  if (player.moveRight) player.x += player.speed * dt;
  if (player.x < roadLeft) player.x = roadLeft;
  if (player.x + player.width > roadRight) player.x = roadRight - player.width;

  const curStage = stages[currentStageIndex];
  if (stageTime <= 18.0 && !landmarkTriggered1) {
    landmarkTriggered1 = true;
    triggerSnapShot(curStage.landmarks[0]);
    roadSigns.push({ text: curStage.cities[0] || "", y: -40, side: "right" });
  }
  if (stageTime <= 8.0 && !landmarkTriggered2) {
    landmarkTriggered2 = true;
    triggerSnapShot(curStage.landmarks[1]);
    roadSigns.push({ text: curStage.cities[1] || "", y: -40, side: "left" });
  }

  if (photoOverlay.active) {
    photoOverlay.timer -= dt;
    if (photoOverlay.timer > 2.0) {
      photoOverlay.alpha += dt * 3.5;
      if (photoOverlay.alpha > 1) photoOverlay.alpha = 1;
    } else if (photoOverlay.timer < 0.45) {
      photoOverlay.alpha -= dt * 2.5;
      if (photoOverlay.alpha < 0) photoOverlay.alpha = 0;
    }
    if (photoOverlay.timer <= 0) photoOverlay.active = false;
  }

  for (let i = roadSigns.length - 1; i >= 0; i--) {
    const s = roadSigns[i];
    s.y += 180 * dt;
    if (s.y > canvas.height + 50) roadSigns.splice(i, 1);
  }

  spawnTimer += dt;
  if (spawnTimer > 1.1) {
    spawnTimer = 0;
    const laneWidth = (roadRight - roadLeft - 44);
    const spawnX = roadLeft + 6 + Math.random() * laneWidth;
    const itemObj = curStage.items[Math.floor(Math.random() * curStage.items.length)];
    const fallbackSrc = itemObj.fallback ? ASSET_PATHS.items + itemObj.fallback : null;
    obstacles.push({
      x: spawnX,
      y: -50,
      width: 40,
      height: 40,
      name: itemObj.name,
      imgSrc: ASSET_PATHS.items + itemObj.file,
      fallbackSrc: fallbackSrc,
      speed: 210 + (30 - stageTime) * 2
    });
  }

  for (let i = obstacles.length - 1; i >= 0; i--) {
    const obs = obstacles[i];
    obs.y += obs.speed * dt;

    const pBox = {
      x: player.x + 8,
      y: player.y + 12,
      w: player.width - 16,
      h: player.height - 24
    };
    const oBox = {
      x: obs.x + 6,
      y: obs.y + 6,
      w: obs.width - 12,
      h: obs.height - 12
    };

    if (
      pBox.x < oBox.x + oBox.w &&
      pBox.x + pBox.w > oBox.x &&
      pBox.y < oBox.y + oBox.h &&
      pBox.y + pBox.h > oBox.y
    ) {
      isGameOver = true;
      transitionLockTimer = 0.5;
      stopBGM();
    }

    if (obs.y > canvas.height + 55) obstacles.splice(i, 1);
  }
}

function render() {
  ctx.clearRect(0, 0, canvas.width, canvas.height);

  ctx.fillStyle = stages[currentStageIndex].bg;
  ctx.fillRect(0, 0, canvas.width, canvas.height);

  const roadLeft = 45;
  const roadWidth = canvas.width - 90;
  ctx.fillStyle = "#3a3a3a";
  ctx.fillRect(roadLeft, 0, roadWidth, canvas.height);

  ctx.strokeStyle = "#ffffff";
  ctx.lineWidth = 3;
  ctx.beginPath();
  ctx.moveTo(roadLeft, 0);
  ctx.lineTo(roadLeft, canvas.height);
  ctx.moveTo(roadLeft + roadWidth, 0);
  ctx.lineTo(roadLeft + roadWidth, canvas.height);
  ctx.stroke();

  ctx.strokeStyle = "#fbc02d";
  ctx.lineWidth = 4;
  ctx.setLineDash([24, 16]);
  ctx.lineDashOffset = -roadMarkY;
  ctx.beginPath();
  ctx.moveTo(canvas.width / 2, 0);
  ctx.lineTo(canvas.width / 2, canvas.height);
  ctx.stroke();
  ctx.setLineDash([]);

  for (const s of roadSigns) {
    if (!s.text) continue;
    const signX = s.side === "left" ? 6 : canvas.width - 38;
    ctx.fillStyle = "#1b5e20";
    ctx.fillRect(signX - 2, s.y - 2, 36, 44);
    ctx.strokeStyle = "#ffffff";
    ctx.lineWidth = 1;
    ctx.strokeRect(signX - 2, s.y - 2, 36, 44);

    ctx.fillStyle = "#ffffff";
    ctx.font = "bold 9px sans-serif";
    ctx.textAlign = "center";
    ctx.fillText("方面", signX + 16, s.y + 10);
    ctx.font = "10px sans-serif";
    const t = s.text.substring(0, 4);
    ctx.fillText(t.substring(0, 2), signX + 16, s.y + 24);
    if (t.length > 2) ctx.fillText(t.substring(2, 4), signX + 16, s.y + 36);
  }

  for (const obs of obstacles) {
    const itemImg = getImage(obs.imgSrc, obs.fallbackSrc);
    if (itemImg && itemImg.complete && itemImg.naturalWidth !== 0) {
      ctx.drawImage(itemImg, obs.x, obs.y, obs.width, obs.height);
    } else {
      ctx.fillStyle = "#d32f2f";
      ctx.beginPath();
      ctx.roundRect(obs.x, obs.y, obs.width, obs.height, 6);
      ctx.fill();
      ctx.strokeStyle = "#fff";
      ctx.lineWidth = 1.5;
      ctx.stroke();
    }

    ctx.font = "bold 10px sans-serif";
    ctx.textAlign = "center";
    ctx.textBaseline = "top";
    ctx.lineJoin = "round";
    ctx.lineWidth = 2.5;
    ctx.strokeStyle = "#000";
    ctx.strokeText(obs.name, obs.x + obs.width / 2, obs.y + obs.height + 2);
    ctx.fillStyle = "#ffeb3b";
    ctx.fillText(obs.name, obs.x + obs.width / 2, obs.y + obs.height + 2);
  }
  ctx.textBaseline = "alphabetic";

  renderMotorcycle(player.x, player.y, player.width, player.height);

  if (photoOverlay.active) drawSnapShot();

  if (isGameOver) {
    ctx.fillStyle = "rgba(0, 0, 0, 0.75)";
    ctx.fillRect(0, 0, canvas.width, canvas.height);
    ctx.fillStyle = "#ff5252";
    ctx.font = "bold 26px sans-serif";
    ctx.textAlign = "center";
    ctx.fillText("転倒！CRASH", canvas.width / 2, canvas.height / 2 - 20);
    ctx.fillStyle = "#ffffff";
    ctx.font = "14px sans-serif";
    ctx.fillText("画面タップでリトライ", canvas.width / 2, canvas.height / 2 + 20);
  } else if (isFerryScene) {
    renderFerryScene();
  } else if (isClear) {
    renderClearScene();
  } else if (isGrandGoal) {
    renderGrandGoal();
  }
}

function renderMotorcycle(x, y, w, h) {
  const cx = x + w / 2;
  const grad = ctx.createLinearGradient(cx, y + 10, cx, y - 140);
  grad.addColorStop(0, "rgba(255, 255, 220, 0.45)");
  grad.addColorStop(1, "rgba(255, 255, 220, 0)");
  ctx.fillStyle = grad;
  ctx.beginPath();
  ctx.moveTo(cx, y + 10);
  ctx.lineTo(cx - 35, y - 140);
  ctx.lineTo(cx + 35, y - 140);
  ctx.closePath();
  ctx.fill();

  if (bikeImg && bikeImg.complete && bikeImg.naturalWidth !== 0) {
    ctx.drawImage(bikeImg, x, y, w, h);
  } else {
    ctx.fillStyle = "#1565c0";
    ctx.fillRect(x + 4, y + 6, w - 8, h - 12);
    ctx.fillStyle = "#111";
    ctx.fillRect(x + 9, y, w - 18, 10);
    ctx.fillRect(x + 9, y + h - 10, w - 18, 10);
    ctx.fillStyle = "#f5f5f5";
    ctx.beginPath();
    ctx.arc(cx, y + 26, 7, 0, Math.PI * 2);
    ctx.fill();
  }
}

function drawSnapShot() {
  ctx.save();
  const posX = canvas.width - 85;
  const posY = 135;
  const photoW = 126;
  const photoH = 146;

  ctx.globalAlpha = photoOverlay.alpha;
  ctx.translate(posX, posY);
  ctx.rotate(photoOverlay.angle);

  ctx.fillStyle = "#ffffff";
  ctx.shadowColor = "rgba(0,0,0,0.5)";
  ctx.shadowBlur = 12;
  ctx.shadowOffsetY = 4;
  ctx.fillRect(-photoW / 2, -photoH / 2, photoW, photoH);
  ctx.shadowColor = "transparent";

  const innerMargin = 7;
  const innerW = photoW - innerMargin * 2;
  const innerH = 88;
  const imgX = -photoW / 2 + innerMargin;
  const imgY = -photoH / 2 + innerMargin;

  const lmImg = getImage(photoOverlay.imgSrc);
  if (lmImg && lmImg.complete && lmImg.naturalWidth !== 0) {
    ctx.drawImage(lmImg, imgX, imgY, innerW, innerH);
  } else {
    ctx.fillStyle = "#2c3e50";
    ctx.fillRect(imgX, imgY, innerW, innerH);
    ctx.fillStyle = "#eceff1";
    ctx.font = "20px sans-serif";
    ctx.textAlign = "center";
    ctx.fillText("📷", 0, -photoH / 2 + 50);
  }

  ctx.fillStyle = "#1a1a1a";
  ctx.font = "bold 11px sans-serif";
  ctx.textAlign = "center";
  ctx.textBaseline = "middle";
  const displayLm = photoOverlay.landmarkName.length > 9 ? photoOverlay.landmarkName.substring(0, 8) + '…' : photoOverlay.landmarkName;
  ctx.fillText(displayLm, 0, photoH / 2 - 25);

  ctx.fillStyle = "#616161";
  ctx.font = "italic 9px sans-serif";
  ctx.fillText(`Passing by ${photoOverlay.title}`, 0, photoH / 2 - 10);

  ctx.restore();
}

function drawCoverImage(img) {
  if (img && img.complete && img.naturalWidth !== 0) {
    const imgW = img.naturalWidth;
    const imgH = img.naturalHeight;
    const scale = Math.max(canvas.width / imgW, canvas.height / imgH);
    const dw = imgW * scale;
    const dh = imgH * scale;
    const dx = (canvas.width - dw) / 2;
    const dy = (canvas.height - dh) / 2;
    ctx.drawImage(img, dx, dy, dw, dh);
    return true;
  }
  return false;
}

function renderClearScene() {
  if (!drawCoverImage(currentEyecatchImg)) {
    ctx.fillStyle = "#1b2838";
    ctx.fillRect(0, 0, canvas.width, canvas.height);
  }

  const bannerH = 190;
  const bannerY = canvas.height - bannerH;
  const grad = ctx.createLinearGradient(0, bannerY - 30, 0, bannerY + 20);
  grad.addColorStop(0, "rgba(0, 0, 0, 0)");
  grad.addColorStop(1, "rgba(0, 0, 0, 0.88)");
  ctx.fillStyle = grad;
  ctx.fillRect(0, bannerY - 30, canvas.width, 50);

  ctx.fillStyle = "rgba(0, 0, 0, 0.88)";
  ctx.fillRect(0, bannerY + 20, canvas.width, bannerH - 20);

  ctx.fillStyle = "#4caf50";
  ctx.font = "bold 26px sans-serif";
  ctx.textAlign = "center";
  ctx.fillText(`${stages[currentStageIndex].name} 制覇！`, canvas.width / 2, bannerY + 45);

  ctx.fillStyle = "#ffca28";
  ctx.font = "bold 17px sans-serif";
  const nextPref = stages[currentStageIndex + 1]?.name || "";
  ctx.fillText(`NEXT ➔ ${nextPref}`, canvas.width / 2, bannerY + 85);

  ctx.fillStyle = "#ffffff";
  ctx.font = "14px sans-serif";
  ctx.fillText("画面タップで出走", canvas.width / 2, bannerY + 125);
}

function renderFerryScene() {
  if (!drawCoverImage(eyecatchFerryImg)) {
    ctx.fillStyle = "rgba(10, 25, 47, 0.95)";
    ctx.fillRect(0, 0, canvas.width, canvas.height);
  }

  const bannerH = 205;
  const bannerY = canvas.height - bannerH;
  const grad = ctx.createLinearGradient(0, bannerY - 30, 0, bannerY + 20);
  grad.addColorStop(0, "rgba(0, 0, 0, 0)");
  grad.addColorStop(1, "rgba(0, 0, 0, 0.88)");
  ctx.fillStyle = grad;
  ctx.fillRect(0, bannerY - 30, canvas.width, 50);

  ctx.fillStyle = "rgba(0, 0, 0, 0.88)";
  ctx.fillRect(0, bannerY + 20, canvas.width, bannerH - 20);

  ctx.fillStyle = "#4fc3f7";
  ctx.font = "bold 22px sans-serif";
  ctx.textAlign = "center";
  ctx.fillText("🚢 フェリー乗船航行中", canvas.width / 2, bannerY + 45);

  ctx.fillStyle = "#e0e0e0";
  ctx.font = "12px sans-serif";
  ctx.fillText(stages[currentStageIndex].ferryNext || "", canvas.width / 2, bannerY + 75);

  ctx.fillStyle = "#ffca28";
  ctx.font = "bold 16px sans-serif";
  const nextName = stages[currentStageIndex + 1]?.name || "";
  ctx.fillText(`上陸地 ➔ ${nextName}`, canvas.width / 2, bannerY + 110);

  ctx.fillStyle = "#ffffff";
  ctx.font = "14px sans-serif";
  ctx.fillText("画面タップで出航・上陸へ", canvas.width / 2, bannerY + 145);
}

function renderGrandGoal() {
  if (!drawCoverImage(eyecatchGoalImg)) {
    ctx.fillStyle = "rgba(0, 0, 0, 0.92)";
    ctx.fillRect(0, 0, canvas.width, canvas.height);
  }

  const bannerH = 175;
  const bannerY = canvas.height - bannerH;
  const grad = ctx.createLinearGradient(0, bannerY - 30, 0, bannerY + 20);
  grad.addColorStop(0, "rgba(0, 0, 0, 0)");
  grad.addColorStop(1, "rgba(0, 0, 0, 0.88)");
  ctx.fillStyle = grad;
  ctx.fillRect(0, bannerY - 30, canvas.width, 50);

  ctx.fillStyle = "rgba(0, 0, 0, 0.88)";
  ctx.fillRect(0, bannerY + 20, canvas.width, bannerH - 20);

  ctx.fillStyle = "#ffd54f";
  ctx.font = "bold 24px sans-serif";
  ctx.textAlign = "center";
  ctx.fillText("47都道府県 完全走破達成！", canvas.width / 2, bannerY + 40);

  ctx.fillStyle = "#ffffff";
  ctx.font = "14px sans-serif";
  ctx.fillText("東京出発 ➔ 沖縄グランドゴール制覇", canvas.width / 2, bannerY + 75);

  ctx.fillStyle = "#81c784";
  ctx.font = "bold 14px sans-serif";
  ctx.fillText("画面タップで再挑戦（ステージ1へ）", canvas.width / 2, bannerY + 120);
}

// 初期起動
resetStage(0);
requestAnimationFrame(gameLoop);
</script>

</body>
</html>
