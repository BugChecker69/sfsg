---
// src/pages/tools/qr.astro
---
<!DOCTYPE html>
<html lang="ja">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>QRコード ジェネレーター - SFSG Tools</title>
<style>
  * { box-sizing: border-box; }
  body {
    margin: 0;
    padding: 24px 16px 40px;
    background-color: #1a1a1a;
    color: #fff;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  .container {
    width: 100%;
    max-width: 480px;
  }
  .nav-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 20px;
  }
  .back-link {
    color: #90caf9;
    text-decoration: none;
    font-size: 13px;
    display: inline-flex;
    align-items: center;
    gap: 4px;
    padding: 6px 12px;
    border: 1px solid #37474f;
    border-radius: 4px;
    background: #212121;
    transition: 0.15s;
  }
  .back-link:hover {
    background: #37474f;
    color: #fff;
  }
  h1 {
    font-size: 20px;
    margin: 0 0 16px;
    text-align: center;
    color: #e0e0e0;
  }
  .card {
    background: #262626;
    border: 1px solid #3d3d3d;
    border-radius: 8px;
    padding: 20px;
    box-shadow: 0 4px 16px rgba(0,0,0,0.4);
  }
  label {
    display: block;
    font-size: 13px;
    font-weight: bold;
    margin-bottom: 6px;
    color: #ccc;
  }
  textarea {
    width: 100%;
    height: 75px;
    background: #1e1e1e;
    border: 1px solid #555;
    border-radius: 6px;
    color: #fff;
    padding: 10px;
    font-size: 14px;
    resize: vertical;
    outline: none;
  }
  textarea:focus {
    border-color: #90caf9;
  }
  .options {
    display: grid;
    grid-template-columns: 1fr 1fr 1fr;
    gap: 8px;
    margin: 14px 0;
  }
  select {
    width: 100%;
    background: #1e1e1e;
    border: 1px solid #555;
    border-radius: 6px;
    color: #fff;
    padding: 8px 4px;
    font-size: 12px;
    outline: none;
  }
  .icon-section {
    margin: 16px 0;
    padding-top: 14px;
    border-top: 1px solid #3d3d3d;
  }
  .preset-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 8px;
    margin-bottom: 12px;
  }
  .preset-btn {
    background: #333;
    border: 1px solid #4f4f4f;
    color: #eee;
    padding: 8px 4px;
    font-size: 12px;
    border-radius: 6px;
    cursor: pointer;
    text-align: center;
    transition: 0.15s;
  }
  .preset-btn:hover {
    background: #444;
  }
  .preset-btn.active {
    background: #1976d2;
    border-color: #90caf9;
    color: #fff;
    font-weight: bold;
  }
  .file-upload-wrapper {
    margin-top: 8px;
  }
  input[type="file"] {
    display: none;
  }
  .file-upload-btn {
    display: block;
    width: 100%;
    padding: 8px;
    background: #2a2a2a;
    border: 1px dashed #666;
    border-radius: 6px;
    color: #bbb;
    font-size: 12px;
    text-align: center;
    cursor: pointer;
    transition: 0.15s;
  }
  .file-upload-btn:hover {
    background: #333;
    border-color: #90caf9;
    color: #fff;
  }
  .btn-group {
    display: flex;
    gap: 10px;
    margin-top: 18px;
  }
  button.action-btn {
    flex: 1;
    padding: 11px;
    border: none;
    border-radius: 6px;
    font-size: 14px;
    font-weight: bold;
    cursor: pointer;
    transition: 0.15s;
  }
  .btn-primary {
    background: #1976d2;
    color: #fff;
  }
  .btn-primary:hover {
    background: #1565c0;
  }
  .btn-download {
    background: #2e7d32;
    color: #fff;
    display: none;
  }
  .btn-download:hover {
    background: #1b5e20;
  }
  .qr-wrapper {
    margin-top: 24px;
    display: flex;
    justify-content: center;
    align-items: center;
    min-height: 250px;
    background: #333;
    border-radius: 8px;
    border: 1px dashed #555;
    padding: 16px;
  }
  #qr-result-canvas {
    display: none;
    background: #fff;
    padding: 12px;
    border-radius: 6px;
    max-width: 100%;
    height: auto;
  }
  .placeholder-text {
    font-size: 13px;
    color: #888;
  }
</style>
</head>
<body>

<div class="container">
  <div class="nav-header">
    <a href="/sfsg/tools/" class="back-link">◀ Toolsに戻る</a>
  </div>

  <h1>QRコード ジェネレーター</h1>

  <div class="card">
    <label for="qr-text">テキスト または URL</label>
    <textarea id="qr-text" placeholder="https://example.com や 任意の文字列を入力"></textarea>

    <div class="options">
      <div>
        <label for="qr-style">デザイン形状</label>
        <select id="qr-style">
          <option value="square" selected>標準 (角型)</option>
          <option value="dots">ドット (丸型)</option>
          <option value="rounded">角丸 (ソフト)</option>
        </select>
      </div>
      <div>
        <label for="qr-size">サイズ</label>
        <select id="qr-size">
          <option value="220">小 (220px)</option>
          <option value="300" selected>中 (300px)</option>
          <option value="400">大 (400px)</option>
        </select>
      </div>
      <div>
        <label for="qr-level">誤り訂正</label>
        <select id="qr-level">
          <option value="L">L (7%)</option>
          <option value="M">M (15%)</option>
          <option value="Q">Q (25%)</option>
          <option value="H" selected>H (30%推奨)</option>
        </select>
      </div>
    </div>

    <div class="icon-section">
      <label>中央アイコン（任意）</label>
      <div class="preset-grid" id="preset-grid">
        <button type="button" class="preset-btn active" data-type="none">なし</button>
        <button type="button" class="preset-btn" data-type="line">LINE</button>
        <button type="button" class="preset-btn" data-type="facebook">Facebook</button>
        <button type="button" class="preset-btn" data-type="instagram">Instagram</button>
        <button type="button" class="preset-btn" data-type="x">X</button>
        <button type="button" class="preset-btn" data-type="youtube">YouTube</button>
        <button type="button" class="preset-btn" data-type="tiktok">TikTok</button>
        <button type="button" class="preset-btn" data-type="mail">Mail</button>
      </div>

      <div class="file-upload-wrapper">
        <label for="custom-file" class="file-upload-btn" id="file-label">📁 任意の画像ファイルを選択 (PNG / JPG / SVG)</label>
        <input type="file" id="custom-file" accept="image/*">
      </div>
    </div>

    <div class="btn-group">
      <button type="button" class="action-btn btn-primary" id="btn-generate">生成する</button>
      <button type="button" class="action-btn btn-download" id="btn-download">PNG保存</button>
    </div>

    <div class="qr-wrapper">
      <canvas id="qr-result-canvas"></canvas>
      <div id="placeholder" class="placeholder-text">テキストを入力して「生成する」を押してください</div>
    </div>
  </div>
</div>

<script type="module">
  import QRCode from 'https://esm.sh/qrcode@1.5.3';

  const SVG_ICONS = {
    line: `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 100 100"><circle cx="50" cy="50" r="50" fill="#06C755"/><path d="M50 20c-18.7 0-33.8 12.3-33.8 27.5 0 9.7 6.1 18.2 15.6 23.1-0.7 2.4-2.5 8.7-2.9 10.1-0.4 1.6 0.6 1.6 1.3 1.1 0.5-0.4 7.6-5.2 10.7-7.3 2.9 0.4 5.9 0.6 9.1 0.6 18.7 0 33.8-12.3 33.8-27.5S68.7 20 50 20z" fill="#FFFFFF"/></svg>`,
    facebook: `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 100 100"><circle cx="50" cy="50" r="50" fill="#1877F2"/><path d="M59.1 52.3l1.8-11.8H49.6v-7.7c0-3.2 1.6-6.4 6.7-6.4h5.2V16.3s-4.7-0.8-9.2-0.8c-9.4 0-15.6 5.7-15.6 16v9H26.3v11.8h10.4v28.6c2.1 0.3 4.2 0.5 6.4 0.5s4.4-0.2 6.4-0.5V52.3h9.6z" fill="#FFFFFF"/></svg>`,
    instagram: `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 100 100"><defs><linearGradient id="ig-grad" x1="0%" y1="100%" x2="100%" y2="0%"><stop offset="0%" stop-color="#FFDC80"/><stop offset="25%" stop-color="#FCAF45"/><stop offset="50%" stop-color="#F77737"/><stop offset="75%" stop-color="#F56040"/><stop offset="100%" stop-color="#FD1D1D"/></linearGradient></defs><rect width="100" height="100" rx="26" fill="url(#ig-grad)"/><rect x="22" y="22" width="56" height="56" rx="16" fill="none" stroke="#FFFFFF" stroke-width="6.5"/><circle cx="50" cy="50" r="14" fill="none" stroke="#FFFFFF" stroke-width="6.5"/><circle cx="65.5" cy="34.5" r="4.2" fill="#FFFFFF"/></svg>`,
    x: `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 100 100"><circle cx="50" cy="50" r="50" fill="#000000"/><path d="M57.6 44.4L77.3 21.5h-4.7L55.5 39.5 41.8 21.5H26l20.7 30.2L26 78.5h4.7l18.1-21.1 14.5 21.1h15.8L57.6 44.4zm-6.4 7.4l-2.1-3-16.7-23.9h7.2l13.5 19.3 2.1 3 17.5 25.1h-7.2L51.2 51.8z" fill="#FFFFFF"/></svg>`,
    youtube: `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 100 100"><rect width="100" height="100" rx="22" fill="#FF0000"/><polygon points="40,32 40,68 68,50" fill="#FFFFFF"/></svg>`,
    tiktok: `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 100 100"><circle cx="50" cy="50" r="50" fill="#000000"/><path d="M68 39.5c-4.4 0-8.2-1.9-10.8-5v25.2c0 9.8-7.9 17.8-17.7 17.8-9.8 0-17.8-7.9-17.8-17.8 0-9.8 7.9-17.7 17.8-17.7 1.2 0 2.4.1 3.5.4v8.2c-1.1-.5-2.3-.8-3.5-.8-5.4 0-9.7 4.3-9.7 9.8s4.3 9.7 9.7 9.7 9.8-4.3 9.8-9.7V17.5h8c1.3 7.8 7.3 14 15 15.2v6.8h-4.2z" fill="#FFFFFF"/></svg>`,
    mail: `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 100 100"><circle cx="50" cy="50" r="50" fill="#EA4335"/><path d="M25 33h50c2.8 0 5 2.2 5 5v26c0 2.8-2.2 5-5 5H25c-2.8 0-5-2.2-5-5V38c0-2.8 2.2-5 5-5zm44.2 8L50 53.6 30.8 41H28v23h44V41h-2.8zM50 49.8l20.4-13.8H29.6L50 49.8z" fill="#FFFFFF"/></svg>`
  };

  const textInput = document.getElementById('qr-text');
  const styleSelect = document.getElementById('qr-style');
  const sizeSelect = document.getElementById('qr-size');
  const levelSelect = document.getElementById('qr-level');
  const generateBtn = document.getElementById('btn-generate');
  const downloadBtn = document.getElementById('btn-download');
  const placeholder = document.getElementById('placeholder');
  const resultCanvas = document.getElementById('qr-result-canvas');
  const presetButtons = document.querySelectorAll('.preset-btn');
  const customFileInput = document.getElementById('custom-file');
  const fileLabel = document.getElementById('file-label');

  let currentIconType = 'none';
  let customImageSrc = null;

  presetButtons.forEach(btn => {
    btn.addEventListener('click', () => {
      presetButtons.forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      currentIconType = btn.dataset.type;
      fileLabel.textContent = "📁 任意の画像ファイルを選択 (PNG / JPG / SVG)";
      customFileInput.value = '';
      customImageSrc = null;

      if (currentIconType !== 'none') {
        levelSelect.value = 'H';
      }
    });
  });

  customFileInput.addEventListener('change', (e) => {
    const file = e.target.files[0];
    if (!file) return;

    const reader = new FileReader();
    reader.onload = (event) => {
      customImageSrc = event.target.result;
      currentIconType = 'custom';
      presetButtons.forEach(b => b.classList.remove('active'));
      fileLabel.textContent = `選択中: ${file.name.substring(0, 18)}`;
      levelSelect.value = 'H';
    };
    reader.readAsDataURL(file);
  });

  function getIconImage() {
    return new Promise((resolve) => {
      if (currentIconType === 'none') {
        resolve(null);
        return;
      }

      const img = new Image();
      img.onload = () => resolve(img);
      img.onerror = () => resolve(null);

      if (currentIconType === 'custom' && customImageSrc) {
        img.src = customImageSrc;
      } else if (SVG_ICONS[currentIconType]) {
        const svgBlob = new Blob([SVG_ICONS[currentIconType]], { type: 'image/svg+xml;charset=utf-8' });
        img.src = URL.createObjectURL(svgBlob);
      } else {
        resolve(null);
      }
    });
  }

  // 四隅の位置検出パターン（切り出しシンボル）の領域か判定する関数
  function isFinderPattern(r, c, moduleCount) {
    if (r < 7 && c < 7) return true; // 左上
    if (r < 7 && c >= moduleCount - 7) return true; // 右上
    if (r >= moduleCount - 7 && c < 7) return true; // 左下
    return false;
  }

  async function makeQR() {
    const text = textInput.value.trim();
    if (!text) {
      resultCanvas.style.display = 'none';
      placeholder.style.display = 'block';
      downloadBtn.style.display = 'none';
      return;
    }

    const targetSize = parseInt(sizeSelect.value, 10);
    const errorCorrectionLevel = levelSelect.value;
    const style = styleSelect.value;

    try {
      // QRコードの生マトリクスデータを生成
      const qrData = QRCode.create(text, {
        errorCorrectionLevel: errorCorrectionLevel
      });

      const moduleCount = qrData.modules.size;
      const marginModules = 2;
      const totalModules = moduleCount + marginModules * 2;
      const moduleSize = Math.floor(targetSize / totalModules);
      const canvasSize = moduleSize * totalModules;

      resultCanvas.width = canvasSize;
      resultCanvas.height = canvasSize;
      const ctx = resultCanvas.getContext('2d');

      // 背景（白）
      ctx.fillStyle = '#ffffff';
      ctx.fillRect(0, 0, canvasSize, canvasSize);

      ctx.fillStyle = '#000000';

      // 各モジュール（ドット）の描画
      for (let r = 0; r < moduleCount; r++) {
        for (let c = 0; c < moduleCount; c++) {
          const isDark = qrData.modules.get(r, c);
          if (!isDark) continue;

          const x = (c + marginModules) * moduleSize;
          const y = (r + marginModules) * moduleSize;

          // 四隅のファインダーパターンは認識精度保持のため四角形で描画
          if (isFinderPattern(r, c, moduleCount) || style === 'square') {
            ctx.fillRect(x, y, moduleSize, moduleSize);
          } else if (style === 'dots') {
            // 丸型ドット
            ctx.beginPath();
            ctx.arc(x + moduleSize / 2, y + moduleSize / 2, moduleSize * 0.42, 0, Math.PI * 2);
            ctx.fill();
          } else if (style === 'rounded') {
            // 角丸スクエア
            ctx.beginPath();
            ctx.roundRect(x + moduleSize * 0.06, y + moduleSize * 0.06, moduleSize * 0.88, moduleSize * 0.88, moduleSize * 0.32);
            ctx.fill();
          }
        }
      }

      // アイコンの合成処理
      const iconImg = await getIconImage();
      if (iconImg) {
        const iconSize = Math.floor(canvasSize * 0.22);
        const iconX = (canvasSize - iconSize) / 2;
        const iconY = (canvasSize - iconSize) / 2;

        // 白い背景マージン（QRのドットとの境界）
        const pad = Math.floor(iconSize * 0.14);
        ctx.fillStyle = '#ffffff';
        ctx.beginPath();
        ctx.roundRect(iconX - pad, iconY - pad, iconSize + pad * 2, iconSize + pad * 2, (iconSize + pad * 2) * 0.22);
        ctx.fill();

        // アイコン描画
        ctx.save();
        ctx.beginPath();
        ctx.roundRect(iconX, iconY, iconSize, iconSize, iconSize * 0.2);
        ctx.clip();
        ctx.drawImage(iconImg, iconX, iconY, iconSize, iconSize);
        ctx.restore();
      }

      placeholder.style.display = 'none';
      resultCanvas.style.display = 'block';
      downloadBtn.style.display = 'block';
    } catch (err) {
      console.error("QR Code generation error:", err);
      alert("QRコードの生成に失敗しました。文字数が多すぎる可能性があります。");
    }
  }

  generateBtn.addEventListener('click', makeQR);
  textInput.addEventListener('keydown', (e) => {
    if (e.key === 'Enter' && (e.ctrlKey || e.metaKey)) {
      makeQR();
    }
  });

  downloadBtn.addEventListener('click', () => {
    const url = resultCanvas.toDataURL('image/png');
    const a = document.createElement('a');
    a.href = url;
    a.download = `qrcode_${styleSelect.value}_${currentIconType}_${Date.now()}.png`;
    a.click();
  });
</script>

</body>
</html>
