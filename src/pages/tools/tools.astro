---
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
---

<!doctype html>
<html lang="ja">
	<head>
		<BaseHead title="Tools - SFSG" description="開発ツール・便利ツール一覧" />
	</head>
	<body>
		<Header />
		<main style="max-width: 800px; width: 100%; margin: 0 auto; padding: 2.5rem 1rem;">
			<h1 class="page-title">Tools</h1>
			<p class="page-desc">公開しているツールの一覧</p>

			<div class="tool-grid">
				<a href="/sfsg/tools/image-tool" class="tool-card">
					<h2>画像加工ツール</h2>
					<p>拡張子変更・サイズ変更・トリミング・選択箇所モザイク処理</p>
				</a>
			</div>
		</main>
		<Footer />

		<style>
			.page-title {
				font-size: 1.5rem;
				font-weight: 700;
				margin-bottom: 0.5rem;
			}
			.page-desc {
				font-size: 0.875rem;
				color: #64748b;
				margin-bottom: 2rem;
			}
			.tool-grid {
				display: grid;
				gap: 1rem;
			}
			.tool-card {
				display: block;
				background-color: #ffffff;
				border: 1px solid #e2e8f0;
				border-radius: 1rem;
				padding: 1.5rem;
				text-decoration: none;
				color: inherit;
				transition: border-color 0.2s, box-shadow 0.2s;
			}
			.tool-card:hover {
				border-color: #94a3b8;
				box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05);
			}
			.tool-card h2 {
				font-size: 1.125rem;
				font-weight: 600;
				margin-bottom: 0.375rem;
				color: #0f172a;
			}
			.tool-card p {
				font-size: 0.875rem;
				color: #64748b;
				margin: 0;
			}
		</style>
	</body>
</html>
