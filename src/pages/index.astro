---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
---

<!doctype html>
<html lang="ja">
  <head>
    <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
  </head>
  <body>
    <Header />
    <main style="max-width: 800px; margin: 0 auto; padding: 3rem 1rem; text-align: center;">
      <img 
        src={`${import.meta.env.BASE_URL.replace(/\/$/, '')}/komaru_sleep_large.png`} 
        alt="SFSG Icon" 
        width="160" 
        height="160"
        style="margin-bottom: 1.5rem;" 
      />
      <h1 style="color: #185A8C; margin: 0 0 0.5rem; font-size: 2.25rem;">{SITE_TITLE}</h1>
      <p style="color: #64748b; margin-bottom: 2rem;">{SITE_DESCRIPTION}</p>
      <p style="font-size: 0.9rem; color: #94a3b8;">Under Construction</p>
    </main>
    <Footer />
  </body>
</html>
