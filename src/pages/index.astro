---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
---

<!doctype html>
<html lang="ja">
	<head>
			<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
			<script type="application/ld+json" set:html={JSON.stringify({
				"@context": "https://schema.org",
				"@type": "WebSite",
				"name": "SFSG",
				"alternateName": "Something Fun is Something Good",
				"url": "https://bugchecker69.github.io/sfsg/"
			})} />
			<style>
			main {
				width: 960px;
				max-width: calc(100% - 2rem);
				margin: 0 auto;
				padding: 3rem 1rem;
				box-sizing: border-box;
				display: flex;
				flex-direction: column;
				align-items: center;
				justify-content: center;
				text-align: center;
			}
			.hero-image {
				max-width: 100%;
				height: auto;
				margin-bottom: 2rem;
			}
			.hero-image img {
				max-width: 100%;
				height: auto;
				display: block;
				margin: 0 auto;
			}
			h1 {
				font-size: clamp(2.2rem, 7vw, 3.5rem);
				line-height: 1.2;
				margin: 0 0 0.5rem 0;
				color: #185A8C;
				word-break: break-word;
				overflow-wrap: anywhere;
			}
			p.subtitle {
				font-size: clamp(1rem, 3.5vw, 1.4rem);
				color: rgb(var(--gray));
				margin: 0;
				word-break: break-word;
				overflow-wrap: anywhere;
			}
			@media (max-width: 720px) {
				main {
					padding: 2rem 1rem;
				}
				.hero-image {
					margin-bottom: 1.5rem;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<h1>SFSG</h1>
			<p class="subtitle">Something Fun is Something Good</p>
			<div class="hero-image">
				<img src="/sfsg/komaru_sleep_large.png" alt="SFSG" width="400" height="400" />
			</div>
		</main>
		<Footer />
	</body>
</html>
