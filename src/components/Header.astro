---
import HeaderLink from './HeaderLink.astro';
import { SITE_TITLE } from '../consts';
---

<header>
	<nav>
		<h2><a href="/sfsg/">{SITE_TITLE}</a></h2>
		<div class="internal-links">
			<HeaderLink href="/sfsg/">Home</HeaderLink>
			<HeaderLink href="/sfsg/blog/">Blog</HeaderLink>
			<HeaderLink href="/sfsg/about/">About</HeaderLink>
		</div>
	</nav>
</header>
<style>
	header {
		margin: 0;
		padding: 0 1em;
		background: white;
		box-shadow: 0 2px 8px rgba(var(--black), 5%);
	}
	h2 {
		margin: 0;
		font-size: 1.25em;
	}

	h2 a,
	h2 a.active {
		text-decoration: none;
	}
	nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
		max-width: 960px;
		margin: 0 auto;
		padding: 1em 0;
		flex-wrap: wrap;
		gap: 0.5em;
	}
	nav a {
		padding: 0.5em 0.5em;
		color: var(--black);
		border-bottom: 4px solid transparent;
		text-decoration: none;
	}
	nav a.active {
		text-decoration: none;
		border-bottom-color: var(--accent);
	}
	.internal-links {
		display: flex;
		gap: 0.5em;
		flex-wrap: wrap;
	}
	@media (max-width: 720px) {
		nav {
			padding: 0.8em 0;
		}
	}
</style>
