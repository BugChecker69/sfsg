---
import HeaderLink from './HeaderLink.astro';
import { SITE_TITLE } from '../consts';
---

<header>
	<nav>
		<h2>
			<a href={import.meta.env.BASE_URL} class="brand-link">
				<img 
					src={`${import.meta.env.BASE_URL.replace(/\/$/, '')}/handshake_small_32.gif`} 
					alt="Logo" 
					width="24" 
					height="24" 
				/>
				{SITE_TITLE}
			</a>
		</h2>
		<div class="internal-links">
			<HeaderLink href={import.meta.env.BASE_URL}>Home</HeaderLink>
			<HeaderLink href={`${import.meta.env.BASE_URL.replace(/\/$/, '')}/blog`}>Blog</HeaderLink>
			<HeaderLink href={`${import.meta.env.BASE_URL.replace(/\/$/, '')}/about`}>About</HeaderLink>
		</div>
	</nav>
</header>
<style>
	header {
		margin: 0;
		padding: 0 1em;
		background: white;
		box-shadow: 0 2px 8px rgba(var(--black), 5%);
	}
	h2 {
		margin: 0;
		font-size: 1em;
	}

	h2 a,
	h2 a.active {
		text-decoration: none;
	}
	.brand-link {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		color: var(--black);
	}
	nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
	}
	nav a {
		padding: 1em 0.5em;
		color: var(--gray-dark);
		border-bottom: 4px solid transparent;
		text-decoration: none;
	}
	nav a.active {
		text-decoration: none;
		border-bottom-color: var(--accent);
	}
</style>
