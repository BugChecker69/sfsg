---
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';

type Props = CollectionEntry<'blog'>['data'] | CollectionEntry<'album'>['data'];

const { title, description, pubDate, updatedDate, heroImage, location } = Astro.props as any;
---

<html lang="ja">
	<head>
		<BaseHead title={title} description={description} />
		<style>
			main {
				width: 100%;
				max-width: 100%;
				margin: 0 auto;
				padding: 1.5em 0;
				box-sizing: border-box;
			}
			article {
				width: 100%;
				max-width: 100%;
				margin: 0 auto;
			}
			.hero-image {
				width: 100%;
				max-width: 720px;
				margin: 0 auto 1.5em auto;
				padding: 0 1em;
				box-sizing: border-box;
			}
			.hero-image img {
				display: block;
				margin: 0 auto;
				border-radius: 12px;
				box-shadow: var(--box-shadow);
				width: 100%;
				max-width: 100%;
				height: auto;
			}
			.prose {
				width: 100%;
				max-width: 720px;
				margin: 0 auto;
				padding: 0 1em;
				color: rgb(var(--gray-dark));
				box-sizing: border-box;
			}
			.title {
				margin-bottom: 1.5em;
				padding: 0.5em 0;
				text-align: left;
				line-height: 1;
			}
			.title h1 {
				margin: 0 0 0.5em 0;
				font-size: clamp(1.4rem, 4.5vw, 2.2rem);
				line-height: 1.4;
				word-break: break-word;
				overflow-wrap: anywhere;
			}
			.date {
				margin-bottom: 0.5em;
				color: rgb(var(--gray));
			}
			.last-updated-on {
				font-style: italic;
			}

			/* 見出しサイズと余白調整 */
			.prose :global(h2) {
				font-size: 1.3rem;
				margin-top: 2rem;
				margin-bottom: 0.8rem;
				padding-bottom: 0.3rem;
				border-bottom: 2px solid #e2e8f0;
				line-height: 1.35;
				word-break: break-word;
				overflow-wrap: anywhere;
			}
			.prose :global(h3) {
				font-size: 1.15rem;
				margin-top: 1.5rem;
				margin-bottom: 0.6rem;
				line-height: 1.35;
				word-break: break-word;
				overflow-wrap: anywhere;
			}
			.prose :global(p),
			.prose :global(li) {
				line-height: 1.7;
				word-break: break-word;
				overflow-wrap: anywhere;
			}

			/* 表の横スクロール対応（スマホでの横飛び出し完全防止） */
			.prose :global(table) {
				display: block;
				width: 100%;
				max-width: 100%;
				overflow-x: auto;
				-webkit-overflow-scrolling: touch;
				border-collapse: collapse;
				margin: 1.5rem 0;
			}
			.prose :global(th),
			.prose :global(td) {
				white-space: nowrap;
				padding: 0.5rem 0.75rem;
				border: 1px solid #e2e8f0;
			}

			/* コードブロック溢れ防止 */
			.prose :global(pre) {
				max-width: 100%;
				overflow-x: auto;
				-webkit-overflow-scrolling: touch;
			}
		</style>
	</head>

	<body>
		<Header />
		<main>
			<article>
				{heroImage && (
					<div class="hero-image">
						{typeof heroImage === 'string' ? (
							<img width={1020} height={510} src={heroImage} alt="" />
						) : (
							<Image width={1020} height={510} src={heroImage} alt="" />
						)}
					</div>
				)}
				<div class="prose">
					<div class="title">
						<div class="date">
							<FormattedDate date={pubDate} />
							{location && <span> / {location}</span>}
							{
								updatedDate && (
									<div class="last-updated-on">
										Last updated on <FormattedDate date={updatedDate} />
									</div>
								)
							}
						</div>
						<h1>{title}</h1>
						<hr />
					</div>
					<slot />
				</div>
			</article>
		</main>
		<Footer />
	</body>
</html>
