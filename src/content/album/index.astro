---
import { getCollection } from 'astro:content';
import BlogPost from '../../layouts/BlogPost.astro';

const albums = (await getCollection('album')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
---

<BlogPost title="Album" description="写真と記録のアルバム">
	<main class="max-w-6xl mx-auto px-4 py-8">
		<h1 class="text-3xl font-bold mb-8">Album</h1>
		<div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-6">
			{
				albums.map((album) => (
					<a href={`/album/${album.id}/`} class="group block bg-white rounded-lg overflow-hidden shadow hover:shadow-lg transition-shadow">
						{album.data.heroImage && (
							<div class="aspect-4/3 overflow-hidden bg-gray-100">
								<img 
									src={album.data.heroImage} 
									alt={album.data.title}
									class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
								/>
							</div>
						)}
						<div class="p-4">
							<p class="text-xs text-gray-500 mb-1">
								{album.data.pubDate.toLocaleDateString('ja-JP')}
								{album.data.location && ` / ${album.data.location}`}
							</p>
							<h2 class="font-bold text-lg group-hover:text-blue-600 transition-colors">
								{album.data.title}
							</h2>
						</div>
					</a>
				))
			}
		</div>
	</main>
</BlogPost>
